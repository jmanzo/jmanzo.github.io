---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Section from "../components/Section.astro";
import Closer from "../components/Closer.astro";
import Years from "../components/Years.astro";
import { CAREER, SITE, yearsSince } from "../consts";

const principles = [
  {
    title: "Measure before touching anything",
    body: "No baseline, no result. If we can't say what the number was before, we can't say the change worked.",
  },
  {
    title: "Never on the live theme",
    body: "Duplicate, work, preview, publish. The store keeps selling while I work on it, and every change can be reverted.",
  },
  {
    title: "Small diffs over big rewrites",
    body: "The fix that survives review is usually the short one. I'd rather ship 80 lines I can defend than 2,000 I can't.",
  },
  {
    title: "Written down",
    body: "Decisions, tradeoffs and the parts that didn't work go into writing, so the next developer doesn't have to rediscover them.",
  },
];

const stack = [
  {
    group: "Shopify",
    items: [
      "Liquid and Online Store 2.0",
      "Theme app extensions",
      "Shopify Plus and checkout extensibility",
      "Admin and Storefront APIs",
      "Headless with Hydrogen",
    ],
  },
  {
    group: "Apps and backend",
    items: ["TypeScript", "Remix", "Node.js", "Prisma", "PostgreSQL and MySQL"],
  },
  {
    group: "Frontend and delivery",
    items: [
      "Preact, Vite and Web Components",
      "Core Web Vitals and page speed",
      "A/B test builds (Convert, Intelligems)",
      "GA4, GTM and Clarity",
      "Claude Code and Cursor",
    ],
  },
];

const testimonials = [
  {
    quote:
      "He works hard, thinks outside of the box and is dedicated to deep work principles.",
    name: "Seva Mouler",
    title: "CEO",
  },
  {
    quote:
      "Excellent knowledge of the Shopify platform combined with a strong work ethic.",
    name: "Harry Molyneux",
    title: "CRO Specialist",
  },
  {
    quote:
      "Knowledgeable and resourceful. Looking forward to future projects together.",
    name: "Enrique Ramirez",
    title: "CEO & Cofounder",
  },
];
---

<Base
  title="About"
  description={`${SITE.author}, ${SITE.role.toLowerCase()} in ${SITE.location}. ${yearsSince(CAREER.developerSince)} years building for the web, ${yearsSince(CAREER.shopifySince)} inside Shopify: apps, extensions, themes and Plus builds.`}
>
  <PageHead
    eyebrow={`About · ${SITE.location}`}
    title="Senior developer, mostly inside Shopify."
    lede="Apps, extensions, themes and the tooling around them, for merchants and the agencies that serve them."
  />

  <Section title="Background">
    <p class="claim">
      I care less about the code than about what it's supposed to do, and that turned out to be
      the most useful thing I learned.
    </p>
    <p>
      I'm Jean Manzo. I've been building for the web for <Years since={CAREER.developerSince} />
      years, the last <Years since={CAREER.shopifySince} /> of them inside Shopify: themes, custom
      apps, Plus builds, headless storefronts and migrations.
    </p>
    <p>
      Most recently I worked at a Shopify Plus agency, until July 2026. Along the way I've
      delivered 84 independent contracts for merchants and agencies, many of them for CRO teams
      who needed experiments built exactly to spec and measured honestly.
    </p>
    <p>
      I value deep work, simple architecture, and code that stays out of the way. I write about
      what I build, including <a href="/blog/">the parts that went wrong</a>.
    </p>
  </Section>

  <Section title="How I work">
    <ol class="steps">
      {
        principles.map((p, i) => (
          <li class="step">
            <div class="step-n">{String(i + 1).padStart(2, "0")}</div>
            <div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section title="Stack">
    <div class="fit">
      {
        stack.map((g) => (
          <div>
            <h3>{g.group}</h3>
            <ul>
              {g.items.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <Section title="What clients say">
    <ul class="quotes">
      {
        testimonials.map((t) => (
          <li>
            <blockquote>“{t.quote}”</blockquote>
            <p class="lab who">{t.name} · {t.title}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Closer />
</Base>
