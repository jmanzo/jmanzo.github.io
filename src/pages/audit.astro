---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { OFFER, SITE } from "../consts";

const deliverables = [
  {
    title: "A 20-minute Loom walkthrough",
    body: "Me on your store, on a real device, showing you the leaks as they happen. Not a checklist — the actual moment a buyer would drop off.",
  },
  {
    title: "The top 10 leaks, ranked",
    body: "Written report. Each leak with what it's costing you per year, how much effort the fix takes, and the lift I'd expect.",
  },
  {
    title: "A fix order",
    body: "What to do first, second, third — and what to ignore. Most audits give you 40 problems and no sequence. That's a paperweight.",
  },
];

const process = [
  {
    step: "01",
    title: "30-minute call",
    body: "You tell me what you sell, where the traffic comes from, and what you've already tried. I tell you whether an audit is worth your money. If it isn't, I say so on the call.",
  },
  {
    step: "02",
    title: "You send access",
    body: "Your store URL and read-only analytics. No admin access, no app installs, nothing touched.",
  },
  {
    step: "03",
    title: "72 hours later",
    body: "Loom plus written report in your inbox. Then a call to walk through it and answer questions.",
  },
];

const fitYes = [
  "DTC brand on Shopify doing $50k–$500k per month",
  "Traffic already coming in — ideally some of it paid",
  "The founder or head of ecommerce makes the call",
  "You sell to consumers, not to businesses",
];

const fitNo = [
  "Pre-traffic store — optimization needs visitors to optimize",
  "B2B or catalog site without consumer traffic",
  "You need a developer for one specific fix, not a diagnosis",
  "You want to buy hours rather than an outcome",
];

const faqs = [
  {
    q: "Do you implement the fixes, or just point at them?",
    a: "Both. The audit is the diagnosis. If you want me to ship the fixes, that's a separate engagement we price on the call — most clients start with the highest-value leak from the report.",
  },
  {
    q: "How is this different from a free audit tool?",
    a: "A tool gives you a score. It can't tell you that your add-to-cart button sits three screens down on mobile, that two of your apps are injecting scripts nobody uses, or which of those two is costing you more. That takes someone who has shipped both the theme and the test.",
  },
  {
    q: "What do you need from me?",
    a: "Your store URL and read-only access to your analytics. That's it. I don't need admin, I don't install anything, and I never touch your live theme.",
  },
  {
    q: "What if I disagree with a finding?",
    a: "Good. Every leak in the report is something you can reproduce on your own phone in under a minute — that's the standard I hold them to. If you can't reproduce it, it doesn't go in the report.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: OFFER.name,
  description: OFFER.promise,
  provider: { "@type": "Person", name: SITE.author, url: SITE.url },
  areaServed: "Worldwide",
  offers: {
    "@type": "Offer",
    price: String(OFFER.price),
    priceCurrency: OFFER.currency,
    url: `${SITE.url}/audit/`,
  },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base
  title={OFFER.name}
  description={`${OFFER.promise} $${OFFER.price}, delivered in ${OFFER.turnaround}. For Shopify DTC brands doing $50k–$500k/month.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <section class="max-w-2xl mx-auto px-6 pt-16 pb-10">
    <p class="text-xs uppercase tracking-widest text-[var(--color-muted)] mb-3">
      {OFFER.name}
    </p>
    <h1
      class="text-3xl sm:text-4xl font-semibold tracking-tight leading-[1.15] mb-6"
      style="font-family: var(--font-serif);"
    >
      Find out exactly where your store leaks money — in 72 hours.
    </h1>
    <p class="text-lg leading-relaxed">
      Your traffic is fine. Your conversion rate isn't. Somewhere between the ad
      click and the thank-you page, buyers are quietly giving up — and every
      week you don't know where, it costs you the same amount again.
    </p>
    <p class="mt-5 text-[var(--color-muted)] leading-relaxed">
      I go through your store the way your customers do, on the device most of
      them actually use, and I come back with a ranked list of what's bleeding,
      what each leak is worth per year, and which one to fix first.
    </p>

    <div
      class="mt-8 flex flex-wrap items-baseline gap-x-6 gap-y-2 border-t border-b border-[var(--color-rule)] py-5"
    >
      <p class="text-2xl font-semibold tabular-nums">
        ${OFFER.price}
      </p>
      <p class="text-[var(--color-muted)]">
        Delivered in {OFFER.turnaround}
      </p>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a
        href={OFFER.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="no-underline inline-flex items-center rounded-md bg-[var(--color-brand)] px-5 py-2.5 font-medium text-white hover:text-white hover:opacity-90 transition-opacity"
      >
        {OFFER.bookingLabel}
      </a>
      <span class="text-sm text-[var(--color-muted)]">
        No pitch on the call. If it's not a fit, I'll tell you.
      </span>
    </div>
  </section>

  <section
    class="max-w-2xl mx-auto px-6 py-10 border-t border-[var(--color-rule)]"
  >
    <h2 class="text-xs uppercase tracking-widest text-[var(--color-muted)] mb-6">
      What you get
    </h2>
    <ul class="space-y-6">
      {
        deliverables.map((d) => (
          <li>
            <h3 class="font-medium mb-1">{d.title}</h3>
            <p class="text-[var(--color-muted)] leading-relaxed">{d.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    class="max-w-2xl mx-auto px-6 py-10 border-t border-[var(--color-rule)]"
  >
    <h2 class="text-xs uppercase tracking-widest text-[var(--color-muted)] mb-4">
      The guarantee
    </h2>
    <p
      class="text-lg leading-relaxed"
      style="font-family: var(--font-serif);"
    >
      {OFFER.guarantee}
    </p>
    <p class="mt-4 text-[var(--color-muted)] leading-relaxed">
      I'm not asking you to trust that an audit is worth ${OFFER.price}. I'm
      taking the risk that it isn't.
    </p>
  </section>

  <section
    class="max-w-2xl mx-auto px-6 py-10 border-t border-[var(--color-rule)]"
  >
    <h2 class="text-xs uppercase tracking-widest text-[var(--color-muted)] mb-6">
      How it works
    </h2>
    <ol class="space-y-6">
      {
        process.map((p) => (
          <li class="flex gap-5">
            <span
              class="text-sm tabular-nums text-[var(--color-muted)] shrink-0 pt-0.5"
              style="font-family: var(--font-mono);"
            >
              {p.step}
            </span>
            <div>
              <h3 class="font-medium mb-1">{p.title}</h3>
              <p class="text-[var(--color-muted)] leading-relaxed">{p.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section
    class="max-w-2xl mx-auto px-6 py-10 border-t border-[var(--color-rule)]"
  >
    <h2 class="text-xs uppercase tracking-widest text-[var(--color-muted)] mb-6">
      Who this is for
    </h2>
    <div class="grid gap-8 sm:grid-cols-2">
      <div>
        <h3 class="font-medium mb-3">A good fit</h3>
        <ul class="space-y-2 text-[var(--color-muted)] leading-relaxed">
          {fitYes.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="font-medium mb-3">Not a fit</h3>
        <ul class="space-y-2 text-[var(--color-muted)] leading-relaxed">
          {fitNo.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section
    class="max-w-2xl mx-auto px-6 py-10 border-t border-[var(--color-rule)]"
  >
    <h2 class="text-xs uppercase tracking-widest text-[var(--color-muted)] mb-6">
      Questions
    </h2>
    <ul class="space-y-6">
      {
        faqs.map((f) => (
          <li>
            <h3 class="font-medium mb-1">{f.q}</h3>
            <p class="text-[var(--color-muted)] leading-relaxed">{f.a}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <Cta
    heading="Book the call"
    body="Thirty minutes. You'll leave knowing whether an audit is worth your money — including if the answer is no."
    showSecondary={false}
  />
</Base>
