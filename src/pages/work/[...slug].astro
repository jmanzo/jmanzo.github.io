---
import Base from "../../layouts/Base.astro";
import Closer from "../../components/Closer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const items = await getCollection("work");
  return items
    .filter((item) => !item.data.url)
    .map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<Base title={item.data.title} description={item.data.description}>
  <article class="wrap article">
    <header class="article-head">
      <div class="eyebrow">
        <span class="dot"></span>
        <span class="lab"><a href="/work/">Work</a> · {item.data.year}</span>
      </div>
      <h1>{item.data.title}</h1>
      <p class="desc">{item.data.description}</p>
    </header>
    <div class="prose article-body">
      <Content />
    </div>
  </article>

  <Closer />
</Base>
