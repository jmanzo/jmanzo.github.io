---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Closer from "../../components/Closer.astro";
import WorkEntry from "../../components/WorkEntry.astro";
import { getCollection } from "astro:content";

const items = (await getCollection("work")).sort(
  (a, b) => (b.data.order ?? 0) - (a.data.order ?? 0)
);
---

<Base
  title="Case studies"
  description="Shopify apps, theme app extensions and storefront features, each with a write-up of how it was built."
>
  <PageHead
    eyebrow="Case studies"
    title="Selected work"
    lede="Shopify apps, extensions and storefront features. Each one has a write-up of how it was built and why."
  />

  <section>
    <div class="wrap sec">
      <div class="panel">
        <div class="panel-head">
          <h2>Case studies</h2>
          <span class="lab">{items.length} entries</span>
        </div>
        {items.map((item, i) => <WorkEntry item={item} index={i} />)}
      </div>
    </div>
  </section>

  <Closer heading="Have something like this to build?" />
</Base>
