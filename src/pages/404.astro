---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Closer from "../components/Closer.astro";
---

<Base title="Not found">
  <PageHead
    eyebrow="404"
    title="Nothing here."
    lede="The page you were looking for doesn't exist, or it moved when the site did."
  >
    <div class="cta-row">
      <a class="btn btn-b" href="/">Back to the home page</a>
    </div>
  </PageHead>

  <Closer />
</Base>
