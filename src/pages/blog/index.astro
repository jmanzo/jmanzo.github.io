---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Closer from "../../components/Closer.astro";
import { getCollection } from "astro:content";
import { formatMonth } from "../../consts";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base
  title="Writing"
  description="Notes on Shopify development, TypeScript, AI-assisted coding, and shipping changes to stores that are taking orders."
>
  <PageHead
    eyebrow="Writing"
    title="Notes from the codebase"
    lede="Shopify, TypeScript, AI-assisted development, and what happens when you ship to a store that's taking orders."
  />

  <section>
    <div class="wrap sec">
      <ul class="rows">
        {
          posts.map((post) => (
            <li class="row">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatMonth(post.data.pubDate)}
              </time>
              <div>
                <h3>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Closer />
</Base>
