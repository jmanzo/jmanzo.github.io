---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Closer from "../components/Closer.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import Years from "../components/Years.astro";
import { getCollection } from "astro:content";
import { CAREER, formatMonth } from "../consts";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const featured = (await getCollection("projects", ({ data }) => data.tier === "featured"))
  .sort((a, b) => (b.data.order ?? 0) - (a.data.order ?? 0));

const stats = [
  { since: CAREER.developerSince, k: "Building for the web" },
  { since: CAREER.shopifySince, k: "Inside Shopify" },
  { v: "84", k: "Contracts delivered" },
  { v: "100%", k: "Job success score" },
];
---

<Base>
  <div class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">
          <span class="dot"></span>
          <span class="lab">Senior developer · Shopify, TypeScript, Node</span>
        </div>

        <h1>I build Shopify apps and storefronts <em>that stay fast and stay shipped.</em></h1>

        <p class="lede">
          <Years since={CAREER.developerSince} /> years building for the web. The last
          <Years since={CAREER.shopifySince} /> years inside Shopify.
        </p>

        <div class="select">
          <b>Custom apps, theme app extensions and Liquid themes</b> for merchants and the
          agencies that serve them, plus the experiments CRO teams need built to spec.
        </div>

        <div class="cta-row">
          <a class="btn btn-a" href="#contact">Get in touch</a>
          <a class="btn btn-b" href="/projects/">See the projects</a>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head">
          <h2>Featured projects</h2>
          <span class="lab">{featured.length} projects</span>
        </div>
        {featured.map((item, i) => <ProjectEntry item={item} index={i} showStack={false} showDescription={false} />)}
        <div class="panel-foot">
          <span>Who it was for and what my part was, on each page.</span>
          <a class="more" href="/projects/">All projects →</a>
        </div>
      </div>
    </div>
  </div>

  <Section title="What I do">
    <p class="claim">
      Senior work is mostly judgment: what to build, what to leave alone, and how to ship it
      without breaking a store that's taking orders.
    </p>
    <p>
      Most of my work lives inside Shopify. Remix and TypeScript apps with Prisma behind them,
      theme app extensions built with Preact and Vite, Online Store 2.0 themes, and the Liquid
      nobody else wants to touch.
    </p>
    <p>
      I use AI tools every day, Claude Code and Cursor included, and I review what they write the
      way I'd review any pull request. <a href="/blog/ai-generated-code-technical-debt/">The job is
      still owning the diff.</a>
    </p>
  </Section>

  <Section title="Track record">
    <div class="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <div class="v">{s.since ? <><Years since={s.since} /> yrs</> : s.v}</div>
            <div class="k">{s.k}</div>
          </div>
        ))
      }
    </div>
    <p>
      The contract numbers are independent work for merchants and agencies, from a public record
      that clients score and I can't edit.
    </p>
  </Section>

  {
    posts.length > 0 && (
      <Section title="Writing">
        <ul class="rows">
          {posts.map((post) => (
            <li class="row">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatMonth(post.data.pubDate)}
              </time>
              <div>
                <h3>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h3>
              </div>
            </li>
          ))}
        </ul>
        <a class="more" href="/blog/">All writing →</a>
      </Section>
    )
  }

  <Closer />
</Base>
