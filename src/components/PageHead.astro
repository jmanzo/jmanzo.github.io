---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<div class="page-head">
  <div class="wrap">
    <div class="eyebrow">
      <span class="dot"></span>
      <span class="lab">{eyebrow}</span>
    </div>
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</div>
