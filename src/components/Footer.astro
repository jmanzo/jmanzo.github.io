---
import { SOCIALS, SITE } from "../consts";
import { UI, type Lang } from "../i18n";
import SocialIcon from "./SocialIcon.astro";

interface Props {
  lang: Lang;
}

const ui = UI[Astro.props.lang];
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <span>© {year} {SITE.author} · {ui.role} · {SITE.location}</span>
    <nav aria-label={Astro.props.lang === "es" ? "Enlaces" : "Elsewhere"}>
      {ui.footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      {
        SOCIALS.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            <SocialIcon name={s.icon} size={15} />
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
