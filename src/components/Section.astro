---
/** The landing's split section: heading on the left rail, content on the right. */
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<section id={id}>
  <div class="wrap sec split">
    <h2>{title}</h2>
    <div class="col">
      <slot />
    </div>
  </div>
</section>
