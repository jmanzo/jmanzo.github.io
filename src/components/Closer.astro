---
import { CONTACT, SOCIALS } from "../consts";

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = "Need a senior developer on something?",
  body = "Tell me what you're building. Thirty minutes on a call and we'll both know whether I'm the right fit, including if the answer is no.",
} = Astro.props;

const linkedin = SOCIALS.find((s) => s.icon === "linkedin");
---

<section class="closer" id="contact">
  <div class="wrap">
    <h2>{heading}</h2>
    <p>{body}</p>
    <div class="cta-row">
      <a class="btn btn-a" href={CONTACT.bookingUrl} target="_blank" rel="noopener">
        {CONTACT.bookingLabel}
      </a>
      {
        linkedin && (
          <a class="btn btn-b" href={linkedin.href} target="_blank" rel="noopener noreferrer">
            Message me on LinkedIn
          </a>
        )
      }
    </div>
  </div>
</section>
