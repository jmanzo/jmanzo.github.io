---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, SOCIALS } from "../consts";
import { UI, langOf } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const lang = langOf(Astro.currentLocale);
const ui = UI[lang];

const {
  title,
  description = ui.description,
  ogType = "website",
  ogImage = "/og.png",
  ogImageAlt = `${SITE.author}, ${ui.role}`,
} = Astro.props;

const fullTitle = title
  ? `${title} · ${SITE.author}`
  : `${SITE.author} · ${ui.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const isDefaultOgImage = ogImage === "/og.png";

// Sitewide identity. Lets search and AI answer engines parse who this is and
// what they work on without reading the copy.
const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      name: SITE.title,
      url: SITE.url,
      publisher: { "@id": `${SITE.url}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${SITE.url}/#person`,
      name: SITE.author,
      url: SITE.url,
      jobTitle: SITE.role,
      description: SITE.description,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Medellín",
        addressCountry: "CO",
      },
      knowsAbout: [
        "Shopify",
        "Shopify Plus",
        "Shopify app development",
        "Theme app extensions",
        "Liquid",
        "TypeScript",
        "Remix",
        "Node.js",
        "Prisma",
        "Web performance",
        "A/B testing implementation",
        "AI-assisted software development",
      ],
      sameAs: SOCIALS.map((s) => s.href),
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f8fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080f16" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="canonical" href={canonical} />
    {
      lang === "en" && (
        <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
      )
    }

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={ui.ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    {
      isDefaultOgImage && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@jdevmanzo" />

    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Roboto:wght@400;500&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <Header lang={lang} />
    <main id="top">
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      // Keeps every <Years> count current between deploys.
      document.querySelectorAll("[data-years-since]").forEach(function (el) {
        el.textContent = String(new Date().getFullYear() - Number(el.dataset.yearsSince));
      });
    </script>
  </body>
</html>
